---
const ADSENSE_ID = 'ca-pub-7135321067279537';
const adsenseActive = !ADSENSE_ID.includes('XXXXX');
const { slot = '0000000000', format = 'auto', layout = 'in-article' } = Astro.props;
---
{adsenseActive && (
  <div class="ad-slot">
    <ins class="adsbygoogle"
      style="display:block"
      data-ad-client={ADSENSE_ID}
      data-ad-slot={slot}
      data-ad-format={format}
      data-full-width-responsive="true"></ins>
    <script is:inline>
      (adsbygoogle = window.adsbygoogle || []).push({});
    </script>
  </div>
)}
