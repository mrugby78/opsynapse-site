---
import Base from '../../layouts/Base.astro';
import AdSlot from '../../components/AdSlot.astro';
import CalcCTA from '../../components/CalcCTA.astro';
import { ui } from '../../i18n/ui';
const lang = 'fr';
const t = (k: string) => ui[lang][k as keyof typeof ui.fr] ?? k;
---

<Base lang={lang} page="tools" title="Calculateur de shrinkage service client gratuit | Opsynapse" description="Calculez votre taux de shrinkage (temps non productif) en service client. Pauses, formations, meetings, administratif. Outil gratuit pour le dimensionnement d'équipe.">

  <section class="page-header">
    <div class="container">
      <span class="hero-tag">{t('site.tagline')}</span>
      <h1>Calculateur de shrinkage</h1>
      <p class="sub">Calculez votre taux de shrinkage, c'est-à-dire le temps non productif de vos agents (pauses, formations, meetings, administratif). Indispensable pour un dimensionnement réaliste.</p>
    </div>
  </section>

  <section style="padding-top:24px">
    <div class="container">
      <div class="calc-layout">
        <div class="calc-form">
          <h2 class="calc-section-title">Vos données</h2>
          <p class="calc-section-desc">Sur une journée type d'un agent :</p>

          <div class="calc-field">
            <label for="paid">Heures payées / jour</label>
            <input type="number" id="paid" min="0" value="7" step="0.5" />
            <span class="calc-field-hint">7h pour 35h, 7.8h pour 39h</span>
          </div>

          <div class="calc-field">
            <label for="breaks">Pauses (min)</label>
            <input type="number" id="breaks" min="0" value="30" />
            <span class="calc-field-hint">Pauses café, déjeuner hors temps productif</span>
          </div>

          <div class="calc-field">
            <label for="meetings">Meetings / huddles (min)</label>
            <input type="number" id="meetings" min="0" value="15" />
            <span class="calc-field-hint">Réunions d'équipe, briefs</span>
          </div>

          <div class="calc-field">
            <label for="training">Formation (min)</label>
            <input type="number" id="training" min="0" value="15" />
            <span class="calc-field-hint">Coaching, e-learning, montée en compétence</span>
          </div>

          <div class="calc-field">
            <label for="admin">Administratif (min)</label>
            <input type="number" id="admin" min="0" value="20" />
            <span class="calc-field-hint">Mails internes, reporting, mise à jour CRM</span>
          </div>

          <div class="calc-field">
            <label for="system">Problèmes système / attente outil (min)</label>
            <input type="number" id="system" min="0" value="10" />
            <span class="calc-field-hint">Lenteur informatique, bugs</span>
          </div>

          <button id="calc-btn" class="btn btn-primary calc-btn">Calculer</button>
        </div>

        <div class="calc-result" id="result" style="display:none">
          <div class="calc-score-block">
            <span class="calc-score-label">Taux de shrinkage</span>
            <div class="calc-score" id="shrink-score">--</div>
            <span class="calc-score-status" id="shrink-status">--</span>
          </div>

          <div class="calc-breakdown">
            <h3>Détail</h3>
            <table class="calc-table">
              <tbody>
                <tr><td>Temps payé</td><td><strong id="r-paid">--</strong> min</td></tr>
                <tr><td>Temps non productif</td><td><strong id="r-nonprod">--</strong> min</td></tr>
                <tr><td>Temps productif réel</td><td><strong id="r-prod">--</strong> min</td></tr>
                <tr><td>Shrinkage</td><td><strong id="r-shrink">--</strong>%</td></tr>
                <tr><td>Si vous dimensionnez 10 agents</td><td><strong id="r-fte">--</strong> agents réellement productifs</td></tr>
              </tbody>
            </table>
          </div>

          <div class="calc-benchmark">
            <h3>Interprétation</h3>
            <p id="shrink-interpretation">--</p>
          </div>

          <div class="calc-benchmark">
            <h3>Benchmarks shrinkage</h3>
            <table class="calc-table">
              <thead>
                <tr><th>Type de centre</th><th>Shrinkage type</th></tr>
              </thead>
              <tbody>
                <tr><td>Centre d'appels entrants</td><td>25-35%</td></tr>
                <tr><td>Support email / ticket</td><td>20-30%</td></tr>
                <tr><td>Back-office</td><td>15-25%</td></tr>
                <tr><td>Centre multicanal</td><td>30-40%</td></tr>
              </tbody>
            </table>
          </div>
        </div>

        <div class="calc-result calc-empty" id="result-empty">
          <p>Entrez vos chiffres et cliquez sur Calculer.</p>
        </div>
      </div>

      <AdSlot slot="1010101010" />

      <div class="calc-info">
        <h2>Le shrinkage, c'est quoi ?</h2>
        <p>Le shrinkage représente la différence entre le temps payé et le temps réellement productif d'un agent. Il inclut tout ce qui n'est pas du traitement de contacts : pauses, réunions, formation, administratif, problèmes système.</p>
        <p>La formule : <strong>Shrinkage = (Temps non productif / Temps payé) x 100</strong></p>
        <p>Un shrinkage de 30% signifie qu'un agent payé 7h par jour ne traite des contacts que pendant 4,9h. Ignorer le shrinkage dans le dimensionnement est l'erreur la plus courante en service client : vous sous-estimez vos besoins de 30%.</p>
      </div>

      <CalcCTA tool="Calculateur shrinkage" />

      <p style="margin-top:32px"><a href="/tools" class="btn btn-ghost">← Retour aux outils</a></p>
    </div>
  </section>
</Base>

<script is:inline>
  function calcShrink() {
    const paid = parseFloat(document.getElementById("paid").value) || 0;
    const breaks = parseInt(document.getElementById("breaks").value) || 0;
    const meetings = parseInt(document.getElementById("meetings").value) || 0;
    const training = parseInt(document.getElementById("training").value) || 0;
    const admin = parseInt(document.getElementById("admin").value) || 0;
    const system = parseInt(document.getElementById("system").value) || 0;

    const paidMin = paid * 60;
    const nonProd = breaks + meetings + training + admin + system;
    const prod = paidMin - nonProd;
    const shrink = (nonProd / paidMin) * 100;

    if (paidMin === 0) { alert("Entrez les heures payees."); return; }

    document.getElementById("shrink-score").textContent = shrink.toFixed(1) + "%";
    document.getElementById("r-paid").textContent = paidMin;
    document.getElementById("r-nonprod").textContent = nonProd;
    document.getElementById("r-prod").textContent = prod;
    document.getElementById("r-shrink").textContent = shrink.toFixed(1);
    document.getElementById("r-fte").textContent = (10 * (1 - shrink / 100)).toFixed(1);

    let status, interpretation;
    if (shrink < 20) {
      status = "Tres faible";
      interpretation = "Votre shrinkage est tres faible. C'est excellent pour la productivite, mais verifiez que les agents ont bien leurs pauses et formations. Un shrinkage trop bas peut signaler un sous-investissement humain.";
    } else if (shrink < 35) {
      status = "Optimal";
      interpretation = "Votre shrinkage est dans la norme. Le dimensionnement est realiste. Surveillez les variations pour detecter les pics de reunions ou de formation.";
    } else if (shrink < 45) {
      status = "Eleve";
      interpretation = "Votre shrinkage est eleve. Vos agents passent trop de temps hors traitement. Identifiez le plus gros poste (reunions, admin, systeme) et optimisez-le.";
    } else {
      status = "Critique";
      interpretation = "Votre shrinkage est critique. Moins de la moitie du temps paye est productif. Cause probable : trop de reunions, outils lents, ou sur-administration. Action immediate requise.";
    }

    document.getElementById("shrink-status").textContent = status;
    document.getElementById("shrink-interpretation").textContent = interpretation;
    document.getElementById("result").style.display = "block";
    document.getElementById("result-empty").style.display = "none";

    const color = shrink < 20 ? "#2e7d32" : shrink < 35 ? "#8a6d1f" : shrink < 45 ? "#e65100" : "#c62828";
    document.getElementById("shrink-score").style.color = color;
    document.getElementById("shrink-status").style.color = color;
  }
  document.getElementById("calc-btn").addEventListener("click", calcShrink);
</script>
