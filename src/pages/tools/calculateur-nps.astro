---
import Base from '../../layouts/Base.astro';
import AdSlot from '../../components/AdSlot.astro';
import { ui } from '../../i18n/ui';
const lang = 'fr';
const t = (k: string) => ui[lang][k as keyof typeof ui.fr] ?? k;
---

<Base lang={lang} page="tools" title="Calculateur de NPS gratuit en ligne | Opsynapse" description="Calculez votre Net Promoter Score (NPS) en temps réel. Entrez vos promoteurs, passifs et détracteurs. Obtenez votre score, son niveau et les benchmarks par secteur. Outil gratuit pour équipes de service client.">
  <section class="page-header">
    <div class="container">
      <span class="hero-tag">{t('site.tagline')}</span>
      <h1>Calculateur de NPS</h1>
      <p class="sub">Calculez votre Net Promoter Score en temps réel. Entrez le nombre de promoteurs, passifs et détracteurs, obtenez votre score, son niveau et le benchmark par secteur.</p>
    </div>
  </section>

  <section style="padding-top:24px">
    <div class="container">
      <div class="calc-layout">
        <div class="calc-form">
          <h2 class="calc-section-title">Vos réponses</h2>
          <p class="calc-section-desc">Répartissez vos répondants selon leur note (0 à 10) :</p>

          <div class="calc-field">
            <label for="promoters">Promoteurs (9-10)</label>
            <input type="number" id="promoters" min="0" value="0" />
            <span class="calc-field-hint">Clients enthousiastes</span>
          </div>

          <div class="calc-field">
            <label for="passives">Passifs (7-8)</label>
            <input type="number" id="passives" min="0" value="0" />
            <span class="calc-field-hint">Clients satisfaits mais neutres</span>
          </div>

          <div class="calc-field">
            <label for="detractors">Détracteurs (0-6)</label>
            <input type="number" id="detractors" min="0" value="0" />
            <span class="calc-field-hint">Clients insatisfaits</span>
          </div>

          <button id="calc-btn" class="btn btn-primary calc-btn">Calculer</button>
        </div>

        <div class="calc-result" id="result" style="display:none">
          <div class="calc-score-block">
            <span class="calc-score-label">Votre NPS</span>
            <div class="calc-score" id="nps-score">--</div>
            <span class="calc-score-status" id="nps-status">--</span>
          </div>

          <div class="calc-breakdown">
            <h3>Répartition</h3>
            <div class="calc-bar">
              <div class="calc-bar-promoters" id="bar-promoters" style="width:0%"></div>
              <div class="calc-bar-passives" id="bar-passives" style="width:0%"></div>
              <div class="calc-bar-detractors" id="bar-detractors" style="width:0%"></div>
            </div>
            <div class="calc-legend">
              <span><span class="dot dot-promoters"></span> Promoteurs : <strong id="pct-promoters">0%</strong></span>
              <span><span class="dot dot-passives"></span> Passifs : <strong id="pct-passives">0%</strong></span>
              <span><span class="dot dot-detractors"></span> Détracteurs : <strong id="pct-detractors">0%</strong></span>
            </div>
          </div>

          <div class="calc-benchmark">
            <h3>Interprétation</h3>
            <p id="nps-interpretation">--</p>
          </div>

          <div class="calc-benchmark">
            <h3>Benchmarks par secteur</h3>
            <table class="calc-table">
              <thead>
                <tr><th>Secteur</th><th>NPS moyen</th></tr>
              </thead>
              <tbody>
                <tr><td>SaaS / Tech</td><td>30-40</td></tr>
                <tr><td>E-commerce</td><td>25-35</td></tr>
                <tr><td>Services financiers</td><td>20-30</td></tr>
                <tr><td>Télécommunications</td><td>0-10</td></tr>
                <tr><td>Assurance</td><td>15-25</td></tr>
                <tr><td>Retail</td><td>25-35</td></tr>
              </tbody>
            </table>
          </div>
        </div>

        <div class="calc-result calc-empty" id="result-empty">
          <p>Entrez vos chiffres et cliquez sur Calculer.</p>
        </div>
      </div>

      <AdSlot slot="1111111111" />

      <div class="calc-info">
        <h2>Le NPS, c'est quoi exactement ?</h2>
        <p>Le Net Promoter Score mesure la likelihood qu'un client recommande votre entreprise. On demande "Sur une échelle de 0 à 10, recommanderiez-vous notre entreprise à un ami ou un collègue ?"</p>
        <p>Les réponses se répartissent en trois groupes :</p>
        <ul class="calc-list">
          <li><strong>Promoteurs (9-10) :</strong> clients fidèles et enthousiastes qui vont parler de vous.</li>
          <li><strong>Passifs (7-8) :</strong> clients satisfaits mais peu engagés, sensibles à la concurrence.</li>
          <li><strong>Détracteurs (0-6) :</strong> clients insatisfaits qui peuvent nuire à votre image.</li>
        </ul>
        <p>La formule : <strong>NPS = % de promoteurs - % de détracteurs</strong>. Le score va de -100 (tous détracteurs) à +100 (tous promoteurs).</p>
      </div>

      <p style="margin-top:32px"><a href="/tools" class="btn btn-ghost">← Retour aux outils</a></p>
    </div>
  </section>
</Base>

<script is:inline define:vars={{}}>
  function calcNPS() {
    const p = parseInt(document.getElementById('promoters').value) || 0;
    const pa = parseInt(document.getElementById('passives').value) || 0;
    const d = parseInt(document.getElementById('detractors').value) || 0;
    const total = p + pa + d;

    if (total === 0) {
      alert('Entrez au moins une valeur.');
      return;
    }

    const pctP = (p / total) * 100;
    const pctPa = (pa / total) * 100;
    const pctD = (d / total) * 100;
    const nps = Math.round(pctP - pctD);

    document.getElementById('nps-score').textContent = nps > 0 ? '+' + nps : nps;

    let status, interpretation;
    if (nps >= 50) {
      status = "Excellent";
      interpretation = "Votre NPS est excellent. Vos clients sont majoritairement des promoteurs. Continuez à entretenir cette relation et utilisez ces ambassadeurs pour générer du bouche-à-oreille.";
    } else if (nps >= 20) {
      status = "Bon";
      interpretation = "Votre NPS est bon. Vous avez une base solide de promoteurs. Concentrez-vous sur les passifs pour les convertir et réduisez les détracteurs en traquant les motifs d'insatisfaction.";
    } else if (nps >= 0) {
      status = "Moyen";
      interpretation = "Votre NPS est moyen. Il y a du travail. Priorité : comprendre pourquoi vos détracteurs le sont. Un entretien qualitatif avec 10 détracteurs vous donnera plus que 1000 chiffres.";
    } else {
      status = "À améliorer";
      interpretation = "Votre NPS est négatif. Vos détracteurs sont plus nombreux que vos promoteurs. C'est urgent : le risque de churn et de réputation est élevé. Commencez par les détracteurs les plus récents, captez leur feedback immédiatement.";
    }

    document.getElementById('nps-status').textContent = status;
    document.getElementById('nps-interpretation').textContent = interpretation;

    document.getElementById('pct-promoters').textContent = pctP.toFixed(1) + '%';
    document.getElementById('pct-passives').textContent = pctPa.toFixed(1) + '%';
    document.getElementById('pct-detractors').textContent = pctD.toFixed(1) + '%';

    document.getElementById('bar-promoters').style.width = pctP + '%';
    document.getElementById('bar-passives').style.width = pctPa + '%';
    document.getElementById('bar-detractors').style.width = pctD + '%';

    document.getElementById('result').style.display = 'block';
    document.getElementById('result-empty').style.display = 'none';

    const scoreColor = nps >= 50 ? '#2e7d32' : nps >= 20 ? '#8a6d1f' : nps >= 0 ? '#e65100' : '#c62828';
    document.getElementById('nps-score').style.color = scoreColor;
    document.getElementById('nps-status').style.color = scoreColor;
  }

  document.getElementById('calc-btn').addEventListener('click', calcNPS);
</script>
