---
import Base from '../../layouts/Base.astro';
import AdSlot from '../../components/AdSlot.astro';
import CalcCTA from '../../components/CalcCTA.astro';
import { ui } from '../../i18n/ui';
const lang = 'fr';
const t = (k: string) => ui[lang][k as keyof typeof ui.fr] ?? k;
---

<Base lang={lang} page="tools" title="Calculateur de SLA gratuit en ligne | Opsynapse" description="Calculez votre taux de respect des SLA service client. Entrez les tickets traités dans les délais et le total. Obtenez votre pourcentage et le statut. Outil gratuit pour managers.">
  <section class="page-header">
    <div class="container">
      <span class="hero-tag">{t('site.tagline')}</span>
      <h1>Calculateur de SLA</h1>
      <p class="sub">Calculez votre taux de respect des SLA. Entrez le nombre de tickets traités dans le temps imparti et le total des tickets, obtenez votre pourcentage de respect et le statut.</p>
    </div>
  </section>

  <section style="padding-top:24px">
    <div class="container">
      <div class="calc-layout">
        <div class="calc-form">
          <h2 class="calc-section-title">Vos données</h2>
          <p class="calc-section-desc">Entrez vos chiffres sur la période analysée (jour, semaine, mois) :</p>

          <div class="calc-field">
            <label for="sla-met">Tickets dans les SLA</label>
            <input type="number" id="sla-met" min="0" value="0" />
            <span class="calc-field-hint">Tickets traités dans le temps imparti</span>
          </div>

          <div class="calc-field">
            <label for="sla-total">Total des tickets</label>
            <input type="number" id="sla-total" min="0" value="0" />
            <span class="calc-field-hint">Tous les tickets de la période</span>
          </div>

          <div class="calc-field">
            <label for="sla-target">Objectif SLA (%)</label>
            <input type="number" id="sla-target" min="0" max="100" value="95" />
            <span class="calc-field-hint">Votre cible de respect (souvent 90 ou 95%)</span>
          </div>

          <button id="calc-btn" class="btn btn-primary calc-btn">Calculer</button>
        </div>

        <div class="calc-result" id="result" style="display:none">
          <div class="calc-score-block">
            <span class="calc-score-label">Taux de respect</span>
            <div class="calc-score" id="sla-score">--</div>
            <span class="calc-score-status" id="sla-status">--</span>
          </div>

          <div class="calc-breakdown">
            <h3>Détail</h3>
            <table class="calc-table">
              <tbody>
                <tr><td>Tickets dans les SLA</td><td><strong id="r-met">--</strong></td></tr>
                <tr><td>Total des tickets</td><td><strong id="r-total">--</strong></td></tr>
                <tr><td>Tickets hors SLA</td><td><strong id="r-missed">--</strong></td></tr>
                <tr><td>Objectif</td><td><strong id="r-target">--</strong></td></tr>
                <tr><td>Écart vs objectif</td><td><strong id="r-gap">--</strong></td></tr>
              </tbody>
            </table>
          </div>

          <div class="calc-benchmark">
            <h3>Interprétation</h3>
            <p id="sla-interpretation">--</p>
          </div>

          <div class="calc-benchmark">
            <h3>Benchmarks SLA par canal</h3>
            <table class="calc-table">
              <thead>
                <tr><th>Canal</th><th>Objectif type</th></tr>
              </thead>
              <tbody>
                <tr><td>Chat en direct</td><td>95% en moins de 60s</td></tr>
                <tr><td>Appel téléphonique</td><td>90% en moins de 60s</td></tr>
                <tr><td>Email</td><td>90% en moins de 4h</td></tr>
                <tr><td>Ticket (Jira/Zendesk)</td><td>95% en moins de 24h</td></tr>
              </tbody>
            </table>
          </div>
        </div>

        <div class="calc-result calc-empty" id="result-empty">
          <p>Entrez vos chiffres et cliquez sur Calculer.</p>
        </div>
      </div>

      <AdSlot slot="2222222222" />

      <div class="calc-info">
        <h2>Le SLA, c'est quoi ?</h2>
        <p>Le SLA (Service Level Agreement) est l'engagement de votre équipe à traiter les demandes clients dans un délai défini. C'est l'indicateur le plus suivi en service client car il impacte directement la satisfaction.</p>
        <p>Un SLA se définit par un pourcentage et un délai. Par exemple : "95% des appels répondus en moins de 60 secondes" ou "90% des emails répondus en moins de 4 heures".</p>
        <p>La formule : <strong>SLA respecté = (tickets dans les délais / total des tickets) x 100</strong></p>
      </div>

      <CalcCTA tool="Calculateur SLA" />

      <p style="margin-top:32px"><a href="/tools" class="btn btn-ghost">← Retour aux outils</a></p>
    </div>
  </section>
</Base>

<script is:inline>
  function calcSLA() {
    const met = parseInt(document.getElementById("sla-met").value) || 0;
    const total = parseInt(document.getElementById("sla-total").value) || 0;
    const target = parseFloat(document.getElementById("sla-target").value) || 95;

    if (total === 0) {
      alert("Entrez au moins un total de tickets.");
      return;
    }

    const rate = (met / total) * 100;
    const missed = total - met;
    const gap = rate - target;

    document.getElementById("sla-score").textContent = rate.toFixed(1) + "%";
    document.getElementById("r-met").textContent = met;
    document.getElementById("r-total").textContent = total;
    document.getElementById("r-missed").textContent = missed;
    document.getElementById("r-target").textContent = target + "%";
    document.getElementById("r-gap").textContent = (gap >= 0 ? "+" : "") + gap.toFixed(1) + " pts";

    let status, interpretation;
    if (rate >= target) {
      status = "Objectif atteint";
      interpretation = "Votre SLA est respecté. Vous traitez " + rate.toFixed(1) + "% de vos tickets dans les délais. Surveillez la tendance pour ne pas relâcher.";
    } else if (rate >= target - 5) {
      status = "Limite";
      interpretation = "Vous etes juste sous votre objectif. " + missed + " tickets sont hors SLA. Analysez les motifs de retard et priorisez les canaux les plus impactes.";
    } else {
      status = "Objectif manque";
      interpretation = "Votre SLA n'est pas atteint. " + missed + " tickets sur " + total + " sont hors delai. Cause probable : sous-effectif, pics de volume non anticipes, ou process trop lent. Agissez immediatement.";
    }

    document.getElementById("sla-status").textContent = status;
    document.getElementById("sla-interpretation").textContent = interpretation;

    document.getElementById("result").style.display = "block";
    document.getElementById("result-empty").style.display = "none";

    const scoreColor = rate >= target ? "#2e7d32" : rate >= target - 5 ? "#e65100" : "#c62828";
    document.getElementById("sla-score").style.color = scoreColor;
    document.getElementById("sla-status").style.color = scoreColor;
  }

  document.getElementById("calc-btn").addEventListener("click", calcSLA);
</script>
