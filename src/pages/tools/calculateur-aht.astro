---
import Base from '../../layouts/Base.astro';
import AdSlot from '../../components/AdSlot.astro';
import CalcCTA from '../../components/CalcCTA.astro';
import { ui } from '../../i18n/ui';
const lang = 'fr';
const t = (k: string) => ui[lang][k as keyof typeof ui.fr] ?? k;
---

<Base lang={lang} page="tools" title="Calculateur AHT (Average Handling Time) gratuit | Opsynapse" description="Calculez votre Average Handling Time (AHT). Temps moyen de traitement d'un contact, conversation + après-appel. Comparez aux benchmarks par canal. Outil gratuit service client.">

  <section class="page-header">
    <div class="container">
      <span class="hero-tag">{t('site.tagline')}</span>
      <h1>Calculateur d'AHT</h1>
      <p class="sub">Calculez votre Average Handling Time : temps moyen de traitement d'un contact. Entrez le temps total de traitement et le nombre de contacts, obtenez l'AHT par canal.</p>
    </div>
  </section>

  <section style="padding-top:24px">
    <div class="container">
      <div class="calc-layout">
        <div class="calc-form">
          <h2 class="calc-section-title">Vos données</h2>
          <p class="calc-section-desc">Sur une période (jour, semaine, mois) :</p>

          <div class="calc-field">
            <label for="aht-total">Temps total de traitement (min)</label>
            <input type="number" id="aht-total" min="0" value="0" />
            <span class="calc-field-hint">Conversation + après-contact (notes, mise à jour CRM)</span>
          </div>

          <div class="calc-field">
            <label for="aht-contacts">Nombre de contacts traités</label>
            <input type="number" id="aht-contacts" min="0" value="0" />
            <span class="calc-field-hint">Tous les contacts de la période</span>
          </div>

          <div class="calc-field">
            <label for="aht-channel">Canal principal</label>
            <select id="aht-channel">
              <option value="phone">Appel téléphonique</option>
              <option value="chat">Chat en direct</option>
              <option value="email">Email / Ticket</option>
            </select>
            <span class="calc-field-hint">Pour comparer aux benchmarks</span>
          </div>

          <button id="calc-btn" class="btn btn-primary calc-btn">Calculer</button>
        </div>

        <div class="calc-result" id="result" style="display:none">
          <div class="calc-score-block">
            <span class="calc-score-label">AHT moyen</span>
            <div class="calc-score" id="aht-score">--</div>
            <span class="calc-score-status" id="aht-status">--</span>
          </div>

          <div class="calc-breakdown">
            <h3>Détail</h3>
            <table class="calc-table">
              <tbody>
                <tr><td>Temps total</td><td><strong id="r-total">--</strong> min</td></tr>
                <tr><td>Contacts traités</td><td><strong id="r-contacts">--</strong></td></tr>
                <tr><td>AHT</td><td><strong id="r-aht">--</strong> min</td></tr>
                <tr><td>AHT en secondes</td><td><strong id="r-aht-sec">--</strong> s</td></tr>
                <tr><td>Standard du canal</td><td><strong id="r-standard">--</strong></td></tr>
                <tr><td>Écart vs standard</td><td><strong id="r-gap">--</strong></td></tr>
              </tbody>
            </table>
          </div>

          <div class="calc-benchmark">
            <h3>Interprétation</h3>
            <p id="aht-interpretation">--</p>
          </div>

          <div class="calc-benchmark">
            <h3>Benchmarks AHT par canal</h3>
            <table class="calc-table">
              <thead>
                <tr><th>Canal</th><th>AHT cible</th></tr>
              </thead>
              <tbody>
                <tr><td>Appel téléphonique (standard)</td><td>3-5 min</td></tr>
                <tr><td>Appel téléphonique (support tech)</td><td>8-15 min</td></tr>
                <tr><td>Chat en direct</td><td>5-10 min</td></tr>
                <tr><td>Email / Ticket</td><td>5-15 min</td></tr>
              </tbody>
            </table>
          </div>
        </div>

        <div class="calc-result calc-empty" id="result-empty">
          <p>Entrez vos chiffres et cliquez sur Calculer.</p>
        </div>
      </div>

      <AdSlot slot="1111111118" />

      <div class="calc-info">
        <h2>L'AHT, c'est quoi ?</h2>
        <p>L'Average Handling Time (AHT) est le temps moyen pour traiter un contact de bout en bout. Il inclut la conversation avec le client ET le temps après-contact (notes, mise à jour du CRM, clôture du ticket).</p>
        <p>La formule : <strong>AHT = Temps total de traitement / Nombre de contacts</strong></p>
        <p>Réduire l'AHT sans sacrifier la qualité est le graal du service client. Les leviers : formation des agents, knowledge base accessible, scripts pour les cas fréquents, et automatisation du après-contact (résumé IA, clôture automatique).</p>
      </div>

      <CalcCTA tool="Calculateur AHT" />

      <p style="margin-top:32px"><a href="/tools" class="btn btn-ghost">← Retour aux outils</a></p>
    </div>
  </section>
</Base>

<script is:inline>
  function calcAHT() {
    const total = parseFloat(document.getElementById("aht-total").value) || 0;
    const contacts = parseInt(document.getElementById("aht-contacts").value) || 0;
    const channel = document.getElementById("aht-channel").value;

    if (contacts === 0) { alert("Entrez un nombre de contacts."); return; }

    const aht = total / contacts;
    const ahtSec = aht * 60;

    const standards = { phone: 4, chat: 7.5, email: 10 };
    const standardLabels = { phone: "3-5 min", chat: "5-10 min", email: "5-15 min" };
    const standard = standards[channel];
    const label = standardLabels[channel];

    document.getElementById("aht-score").textContent = aht.toFixed(1) + " min";
    document.getElementById("r-total").textContent = total.toLocaleString("fr-FR");
    document.getElementById("r-contacts").textContent = contacts.toLocaleString("fr-FR");
    document.getElementById("r-aht").textContent = aht.toFixed(1) + " min";
    document.getElementById("r-aht-sec").textContent = ahtSec.toFixed(0);
    document.getElementById("r-standard").textContent = label;

    const gap = aht - standard;
    document.getElementById("r-gap").textContent = gap > 0 ? "+" + gap.toFixed(1) + " min" : gap.toFixed(1) + " min";

    let status, interpretation;
    if (aht <= standard * 0.8) {
      status = "Excellent";
      interpretation = "Votre AHT est tres bon, sous le standard du canal. Les agents traitent vite sans sacrifier la qualite. Maintenez ce niveau.";
    } else if (aht <= standard) {
      status = "Conforme";
      interpretation = "Votre AHT est dans le standard du canal. Bon equilibre. Surveillez les agents au-dessus de la moyenne pour identifier les sujets de formation.";
    } else if (aht <= standard * 1.5) {
      status = "A ameliorer";
      interpretation = "Votre AHT est au-dessus du standard. Causes probables : knowledge base incomplete, agents en montee en competence, ou process trop complexe. Ciblez la formation.";
    } else {
      status = "Eleve";
      interpretation = "Votre AHT est nettement au-dessus du standard. Les contacts sont trop longs. Cause possible : sujets complexes (justifie), mauvaise qualification des agents, ou outils lents. Analyse par type de contact necessaire.";
    }

    document.getElementById("aht-status").textContent = status;
    document.getElementById("aht-interpretation").textContent = interpretation;
    document.getElementById("result").style.display = "block";
    document.getElementById("result-empty").style.display = "none";

    const color = aht <= standard * 0.8 ? "#2e7d32" : aht <= standard ? "#8a6d1f" : aht <= standard * 1.5 ? "#e65100" : "#c62828";
    document.getElementById("aht-score").style.color = color;
    document.getElementById("aht-status").style.color = color;
  }
  document.getElementById("calc-btn").addEventListener("click", calcAHT);
</script>
