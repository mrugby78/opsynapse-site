---
import Base from '../layouts/Base.astro';
import { ui } from '../i18n/ui';
const lang = 'fr';
const t = (k: string) => ui[lang][k as keyof typeof ui.fr] ?? k;
const tools = [
  { title: t('tools.item.1.title'), text: t('tools.item.1.text') },
  { title: t('tools.item.2.title'), text: t('tools.item.2.text') },
  { title: t('tools.item.3.title'), text: t('tools.item.3.text') },
  { title: t('tools.item.4.title'), text: t('tools.item.4.text') },
  { title: t('tools.item.5.title'), text: t('tools.item.5.text') },
  { title: t('tools.item.6.title'), text: t('tools.item.6.text') },
];
---
<Base lang={lang} page="tools">
  <section class="page-header">
    <div class="container">
      <span class="hero-tag">{t('site.tagline')}</span>
      <h1>{t('tools.title')}</h1>
      <p class="sub">{t('tools.intro')}</p>
    </div>
  </section>
  <section style="padding-top:24px">
    <div class="container">
      <div class="card-grid">
        {tools.map(tl => (
          <div class="card">
            <h3>{tl.title}</h3>
            <p>{tl.text}</p>
          </div>
        ))}
      </div>
      <p style="margin-top:32px;color:var(--text-dim)">{t('tools.next')}</p>
    </div>
  </section>

  <section style="padding-top:24px">
    <div class="container">
      <h2>Calculateurs en ligne</h2>
      <p class="sub" style="margin-bottom:32px">Des calculateurs gratuits pour piloter votre service client. Entrez vos chiffres, obtenez le résultat en temps réel.</p>
      <div class="card-grid">
        <a href="/tools/calculateur-nps" class="card" style="text-decoration:none">
          <h3>Calculateur de NPS</h3>
          <p>Calculez votre Net Promoter Score, obtenez son niveau et comparez aux benchmarks par secteur.</p>
        </a>
        <a href="/tools/calculateur-sla" class="card" style="text-decoration:none">
          <h3>Calculateur de SLA</h3>
          <p>Calculez votre taux de respect des SLA et comparez aux objectifs par canal.</p>
        </a>
        <a href="/tools/calculateur-fte" class="card" style="text-decoration:none">
          <h3>Calculateur d'effectifs (FTE)</h3>
          <p>Calculez combien d'agents vous devez mobiliser pour absorber votre volume de tickets.</p>
        </a>
        <a href="/tools/calculateur-cout-ticket" class="card" style="text-decoration:none">
          <h3>Calculateur de coût par ticket</h3>
          <p>Calculez le coût unitaire de chaque ticket et comparez aux benchmarks par modèle de support.</p>
        </a>
        <a href="/tools/calculateur-churn" class="card" style="text-decoration:none">
          <h3>Calculateur d'impact churn</h3>
          <p>Calculez l'impact financier de votre churn et visualisez l'argent perdu par mois et par an.</p>
        </a>
        <a href="/tools/calculateur-temps-reponse" class="card" style="text-decoration:none">
          <h3>Calculateur de temps de réponse</h3>
          <p>Calculez votre temps de réponse moyen et comparez aux standards par canal.</p>
        </a>
        <a href="/tools/calculateur-csat" class="card" style="text-decoration:none">
          <h3>Calculateur de CSAT</h3>
          <p>Calculez votre Customer Satisfaction Score par canal (appel, chat, ticket).</p>
        </a>
        <a href="/tools/calculateur-fcr" class="card" style="text-decoration:none">
          <h3>Calculateur de FCR</h3>
          <p>Calculez votre taux de résolution au premier contact et l'impact sur la charge.</p>
        </a>
        <a href="/tools/calculateur-abandon" class="card" style="text-decoration:none">
          <h3>Calculateur d'abandon d'appels</h3>
          <p>Calculez votre taux d'abandon d'appels et le nombre de clients perdus.</p>
        </a>
        <a href="/tools/calculateur-shrinkage" class="card" style="text-decoration:none">
          <h3>Calculateur de shrinkage</h3>
          <p>Calculez votre temps non productif (pauses, meetings, formation, admin).</p>
        </a>
        <a href="/tools/calculateur-asa" class="card" style="text-decoration:none">
          <h3>Calculateur d'ASA</h3>
          <p>Calculez votre Average Speed of Answer et comparez aux standards.</p>
        </a>
        <a href="/tools/calculateur-cout-appel" class="card" style="text-decoration:none">
          <h3>Calculateur de coût par appel</h3>
          <p>Calculez le coût unitaire de chaque appel téléphonique traité.</p>
        </a>
        <a href="/tools/calculateur-erlang-c" class="card" style="text-decoration:none">
          <h3>Calculateur Erlang C</h3>
          <p>Dimensionnez votre centre d'appels avec la formule de référence mondiale.</p>
        </a>
        <a href="/tools/generateur-reponses" class="card" style="text-decoration:none">
          <h3>Générateur de réponses IA</h3>
          <p>Générez des réponses client professionnelles et empathiques en un clic.</p>
        </a>
        <a href="/tools/generateur-sla" class="card" style="text-decoration:none">
          <h3>Générateur de SLA</h3>
          <p>Générez un document SLA structuré et prêt à utiliser pour votre équipe.</p>
        </a>
        <a href="/tools/calculateur-deflection" class="card" style="text-decoration:none">
          <h3>Calculateur de déflection</h3>
          <p>Calculez le % de tickets évités par votre self-service et le ROI de l'automatisation.</p>
        </a>
        <a href="/tools/calculateur-aht" class="card" style="text-decoration:none">
          <h3>Calculateur d'AHT</h3>
          <p>Calculez votre Average Handling Time et comparez aux benchmarks par canal.</p>
        </a>
      </div>
    </div>
  </section>
</Base>