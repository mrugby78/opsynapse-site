---
import Base from '../layouts/Base.astro';
import { ui } from '../i18n/ui';
const lang = 'fr';
const t = (k: string) => ui[lang][k as keyof typeof ui.fr] ?? k;

const jobs = [
  {
    date: '2025 — présent',
    role: 'Head of Customer Success France',
    company: 'Fintech · paiements commerçants',
    desc: 'Pilotage de l\'activité CS France dans une fintech en forte croissance. Management et structuration de l\'équipe CS, recrutement, onboarding, développement des collaborateurs. Pilotage de la performance (NPS, temps de réponse, résolution, qualité). Amélioration des process entre CS, Operations et plusieurs départements. Intégration de l\'IA et de l\'automatisation comme leviers de productivité.',
    tags: ['NPS -14 → 45', 'Management multi-équipes', 'IA & automatisation', 'Process transverses']
  },
  {
    date: '2022 — 2025',
    role: 'Head of Customer Success France',
    company: 'Scale-up automobile',
    desc: 'Construction de l\'activité française à partir de zéro. Stratégie CS, recrutement et management d\'une équipe multidisciplinaire de 7 personnes. CS + ops chauffeurs + coordination garages. Création des process, outils et standards de qualité. Pilotage NPS > 65 visé, > 90% d\'appels pris, temps de réponse < 60s. Gestion des escalades et situations complexes. Déploiement d\'une plateforme B2B pour Renault.',
    tags: ['Build from scratch', 'NPS > 65', 'Déploiement Renault', 'Ops 24/7']
  },
  {
    date: '2019 — 2022',
    role: 'Responsable Service Clients France',
    company: 'Scale-up intérim digital',
    desc: 'Management et coaching d\'une équipe de 8 agents en très forte croissance. Dimension double : B2B (entreprises clientes) et B2C (intérimaires). Création des process, SLA, taxonomies et systèmes de classification. Reporting, tableaux de bord, automatisation des réponses. Collaboration Produit/Tech/Sales/Ops dans un environnement où tout change vite.',
    tags: ['B2B + B2C', 'Forte croissance', 'SLA & taxonomies', 'Reporting automatisé']
  },
  {
    date: '2010 — 2016',
    role: 'Shift Leader · Chef de projet Service Client',
    company: 'Leader du poker en ligne · international',
    desc: 'Service client international 24/7 avec coordination d\'équipes réparties en France, Royaume-Uni, Malte, Costa Rica et Australie. Plus de 70 agents à coordonner sur plusieurs fuseaux horaires. Premier point de contact pour les escalades opérationnelles. Gestion des plannings et ajustement des ressources en Workforce Management. Suivi de performance, coaching et formation des agents. Investigation de dossiers complexes. Communication lors des incidents systèmes.',
    tags: ['70+ agents multi-pays', '24/7 multi-fuseaux', 'Workforce Management', 'Escalades complexes']
  },
  {
    date: '2008 — 2010',
    role: 'Commercial Account Manager',
    company: 'Éditeur · Irlande',
    desc: 'Vente B2B de produits personnalisés depuis l\'Irlande. Prospection, développement du portefeuille, fidélisation. Formation et mentorat des nouveaux collaborateurs. Objectifs commerciaux hebdomadaires. Première vraie école du besoin client et du travail par objectifs chiffrés.',
    tags: ['Vente B2B', 'Mentorat', 'Objectifs chiffrés']
  },
  {
    date: '2006 — 2008',
    role: 'Assistant responsable télémarketing',
    company: 'Télémarketing',
    desc: 'Premier poste. Prospection B2C, qualification de prospects, prise de rendez-vous. Création d\'un poste dédié à la génération de nouveaux clients : scripts d\'appels, argumentaires, stratégie de prospection.',
    tags: ['Prospection B2C', 'Scripts & argumentaires']
  },
];

const edu = [
  { date: '2026', title: "CS50's Introduction to AI with Python", school: 'Harvard University' },
  { date: '2024 — 2025', title: 'Chef de projet IA — Bac+5', school: '26academy' },
  { date: '2025', title: 'Learning AI Through Visualization', school: 'Columbia University' },
  { date: '2025', title: 'Certification Make Foundation', school: 'Make (automatisation)' },
  { date: '2025', title: 'ChatGPT Prompt Engineering for Developers', school: 'OpenAI' },
  { date: '2018 — 2019', title: 'Développeur intégrateur web', school: '3W Academy' },
];

const langs = [
  { name: 'Français', level: 'Langue maternelle' },
  { name: 'Anglais', level: 'Professionnel courant' },
  { name: 'Espagnol', level: 'Notions élémentaires' },
];
---

<Base lang={lang} page="parcours" title="Parcours | Opsynapse" description="20 ans d'expérience en service client, opérations et management. De la prospection commerciale au pilotage par l'IA. Construction et structuration d'équipes dans des scale-ups tech et des multinationales.">

  <section class="page-header">
    <div class="container">
      <span class="hero-tag">{t('site.tagline')}</span>
      <h1>Parcours</h1>
      <p class="sub">20 ans à l'intersection du commerce, du service client, des opérations et de l'IA. Un fil conducteur clair : structurer des équipes et piloter par les indicateurs, dans des environnements qui changent vite et beaucoup.</p>
    </div>
  </section>

  <section style="padding-top:24px">
    <div class="container">
      <div class="timeline">
        {jobs.map(j => (
          <div class="timeline-item">
            <div class="date">{j.date}</div>
            <div>
              <div class="role">{j.role}</div>
              <div class="company">{j.company}</div>
              <div class="desc">{j.desc}</div>
              <div class="pills">
                {j.tags.map(tag => <span class="pill">{tag}</span>)}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <h2>Formation & certifications</h2>
      <div class="card-grid">
        {edu.map(e => (
          <div class="card">
            <h3>{e.title}</h3>
            <div class="meta">{e.school} · {e.date}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="about-grid">
        <div>
          <h2>Langues</h2>
          <div class="card-grid">
            {langs.map(l => (
              <div class="card">
                <h3>{l.name}</h3>
                <div class="meta">{l.level}</div>
              </div>
            ))}
          </div>
        </div>
        <div>
          <h2>Positionnement</h2>
          <p style="color:var(--text-dim)">À l'intersection du Customer Success, des opérations, du management et de l'intelligence artificielle. L'IA, le no-code et l'automatisation comme leviers pour améliorer les équipes, les décisions, les process et la performance.</p>
        </div>
      </div>
    </div>
  </section>
</Base>
