---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ui } from '../i18n/ui';

interface Props { lang: 'fr' | 'en'; page: string; }
const { lang, page } = Astro.props;
const t = (key: string) => ui[lang][key as keyof typeof ui.fr] ?? key;
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{t('site.name')} · {t('site.tagline')}</title>
  <meta name="description" content={t('hero.subtitle')} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&display=swap" rel="stylesheet" />
</head>
<body>
  <Header lang={lang} page={page} />
  <main>
    <slot />
  </main>
  <Footer lang={lang} />
</body>
</html>
