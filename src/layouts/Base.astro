---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ui } from '../i18n/ui';

interface Props { lang: 'fr' | 'en'; page: string; title?: string; description?: string; }
const { lang, page, title, description } = Astro.props;
const t = (key: string) => ui[lang][key as keyof typeof ui.fr] ?? key;
const pageTitle = title ?? `${t('site.name')} · ${t('site.tagline')}`;
const pageDesc = description ?? t('hero.subtitle');
const ADSENSE_ID = 'ca-pub-7135321067279537';
const adsenseActive = !ADSENSE_ID.includes('XXXXX');
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDesc} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&display=swap" rel="stylesheet" />
  {adsenseActive && (
    <script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client={ADSENSE_ID}" crossorigin="anonymous"></script>
  )}
</head>
<body>
  <Header lang={lang} page={page} />
  <main>
    <slot />
  </main>
  <Footer lang={lang} />
</body>
</html>
